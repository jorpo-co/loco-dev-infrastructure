
# ── Network ──
LOCO_NETWORK_NAME=loco
LOOPBACK_IP=10.254.254.254
LOOPBACK_INTERFACE=lo0

# ── DNS ──
DNS_PLIST_LABEL=com.loco.infra
DNS_TLDS=loco

# ── Traefik ──
TRAEFIK_CONFIG_SUBDIR=etc/traefik/configs

# ── Registry ──
REGISTRY_HOST=registry.loco
REGISTRY_PORT=5001

# ── Kind ──
KIND_HTTP_PORT_START=30080
KIND_TLS_PORT_START=30443

# ── TLS Certs ──
CERTS_RELPATH=etc/certs

# ── File Locations (relative to project root) ──
TEMPLATES_RELPATH=templates
PORT_ALLOCATIONS_RELPATH=var/port-allocations.json
